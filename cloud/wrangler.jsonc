{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeus-descobuddy",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "POLL_SECONDS": "900",
    "MAX_USERS": "50",
    "CRON_BATCH": "2"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zeus-descobuddy",
      "database_id": "bf677c1a-1f67-4758-9e1d-91a0b299a6b4",
      "migrations_dir": "migrations"
    }
  ]
}
