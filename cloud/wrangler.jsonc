{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeus-descobuddy",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "observability": {
    "enabled": false,
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "vars": {
    "POLL_SECONDS": "900",
    "MAX_USERS": "50",
    "CRON_BATCH": "2",
  },
  "ratelimits": [
    {
      "name": "USER_UPDATES",
      "namespace_id": "18101001",
      "simple": { "limit": 12, "period": 60 },
    },
    {
      "name": "EXPENSIVE_UPDATES",
      "namespace_id": "18101002",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      "name": "ONBOARDING",
      "namespace_id": "18101003",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zeus-descobuddy",
      "database_id": "bf677c1a-1f67-4758-9e1d-91a0b299a6b4",
      "migrations_dir": "migrations",
    },
  ],
}
