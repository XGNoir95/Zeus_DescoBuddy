# Run: python -m descobuddy setup
# Get a NEW token from @BotFather. Never paste it into source or logs.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID, NOT a username. Setup explains how to find it.
OWNER_TELEGRAM_ID=
DATA_DIR=./data
TIMEZONE=Asia/Dhaka
POLL_SECONDS=300
STALE_HOURS=24
# Optional independently verified tariff configuration (see README).
TARIFF_FILE=
